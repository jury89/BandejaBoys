rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isNotifier() {
      return signedIn()
        && request.auth.token.email == 'codex@kirivoraup.resend.app'
        && request.auth.token.email_verified == true;
    }

    function isMember() {
      return signedIn() && !isNotifier();
    }

    function isSlotAdmin() {
      return isMember() && request.auth.uid == '4VSiYJso4YSWf35Rg8Cp0Q8hVmu2';
    }

    // Product pause switches. Keep validation logic below intact for a future reactivation.
    function matchFeedbackEnabled() {
      return false;
    }

    function fantasyBandejaWritesEnabled() {
      return false;
    }

    function validAvatar() {
      return !request.resource.data.keys().hasAny(['avatarDataUrl'])
        || (request.resource.data.avatarDataUrl is string
          && request.resource.data.avatarDataUrl.size() <= 100000
          && request.resource.data.avatarDataUrl.matches(
            '^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'
          ));
    }

    function validNotificationPreferences() {
      return !request.resource.data.keys().hasAny(['notificationPreferences'])
        || (request.resource.data.notificationPreferences is map
          && request.resource.data.notificationPreferences.keys().hasOnly([
            'mondayMotivation', 'newSlots', 'slotReady', 'starterSubstitution', 'bookingReminder7d',
            'reminder24h', 'reminder2h', 'matchFeedback', 'matchMvp', 'matchRating', 'fantasy'
          ])
          && request.resource.data.notificationPreferences.keys().hasAll([
            'mondayMotivation', 'newSlots', 'slotReady', 'bookingReminder7d',
            'reminder24h', 'reminder2h'
          ])
          && request.resource.data.notificationPreferences.keys().hasAny(['matchFeedback', 'matchMvp', 'matchRating'])
          && request.resource.data.notificationPreferences.mondayMotivation is bool
          && request.resource.data.notificationPreferences.newSlots is bool
          && request.resource.data.notificationPreferences.slotReady is bool
          && (!request.resource.data.notificationPreferences.keys().hasAny(['starterSubstitution'])
            || request.resource.data.notificationPreferences.starterSubstitution is bool)
          && request.resource.data.notificationPreferences.bookingReminder7d is bool
          && request.resource.data.notificationPreferences.reminder24h is bool
          && request.resource.data.notificationPreferences.reminder2h is bool
          && (!request.resource.data.notificationPreferences.keys().hasAny(['matchFeedback'])
            || request.resource.data.notificationPreferences.matchFeedback is bool)
          && (!request.resource.data.notificationPreferences.keys().hasAny(['matchMvp'])
            || request.resource.data.notificationPreferences.matchMvp is bool)
          && (!request.resource.data.notificationPreferences.keys().hasAny(['matchRating'])
            || request.resource.data.notificationPreferences.matchRating is bool)
          && (!request.resource.data.notificationPreferences.keys().hasAny(['fantasy'])
            || request.resource.data.notificationPreferences.fantasy is bool));
    }

    function validUserProfile(userId) {
      return request.resource.data.keys()
          .hasOnly([
            'id', 'displayName', 'email', 'createdAt', 'avatarDataUrl',
            'notificationPreferences'
          ])
        && request.resource.data.id == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.createdAt is number
        && validAvatar()
        && validNotificationPreferences();
    }

    function validMatchFeedbackRating(rating) {
      return rating is map
        && rating.keys().hasOnly(['playerId', 'playerName', 'level', 'scoreUnits'])
        && rating.playerId is string
        && rating.playerId != request.auth.uid
        && rating.playerName is string
        && rating.playerName.size() >= 2
        && rating.playerName.size() <= 40
        && rating.level is int
        && rating.level >= 1
        && rating.level <= 5
        && rating.scoreUnits is int
        && ((rating.level == 1 && rating.scoreUnits == 8)
          || (rating.level == 2 && rating.scoreUnits == 10)
          || (rating.level == 3 && rating.scoreUnits == 12)
          || (rating.level == 4 && rating.scoreUnits == 15)
          || (rating.level == 5 && rating.scoreUnits == 18));
    }

    function validMatchFeedbackRatings(ratings) {
      return ratings is list
        && ratings.size() >= 1
        && ratings.size() <= 3
        && validMatchFeedbackRating(ratings[0])
        && (ratings.size() < 2 || validMatchFeedbackRating(ratings[1]))
        && (ratings.size() < 3 || validMatchFeedbackRating(ratings[2]))
        && (ratings.size() < 2 || ratings[0].playerId != ratings[1].playerId)
        && (ratings.size() < 3 || (ratings[0].playerId != ratings[2].playerId
          && ratings[1].playerId != ratings[2].playerId));
    }

    function feedbackResponseHasRating(response, playerId, scoreUnits) {
      return response.data.ratings.size() >= 1
          && response.data.ratings[0].playerId == playerId
          && response.data.ratings[0].scoreUnits == scoreUnits
        || response.data.ratings.size() >= 2
          && response.data.ratings[1].playerId == playerId
          && response.data.ratings[1].scoreUnits == scoreUnits
        || response.data.ratings.size() >= 3
          && response.data.ratings[2].playerId == playerId
          && response.data.ratings[2].scoreUnits == scoreUnits;
    }

    function validMatchFeedbackResponse(responseId) {
      let isSubmitted = request.resource.data.status == 'submitted';
      return request.resource.data.keys().hasOnly([
          'id', 'pollId', 'slotId', 'reviewerId', 'status', 'ratings', 'closedAt'
        ])
        && request.resource.data.id == responseId
        && responseId == request.resource.data.pollId + '__' + request.resource.data.slotId + '__' + request.auth.uid
        && request.resource.data.pollId is string
        && request.resource.data.slotId is string
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.status in ['dismissed', 'submitted']
        && request.resource.data.closedAt is number
        && (isSubmitted
          ? (request.resource.data.keys().hasAll(['ratings'])
            && validMatchFeedbackRatings(request.resource.data.ratings))
          : !request.resource.data.keys().hasAny(['ratings']));
    }

    function validMatchFeedbackSummary(summaryId) {
      let response = getAfter(
        /databases/$(database)/documents/matchFeedbackResponses/$(request.resource.data.lastResponseId)
      );
      return request.resource.data.keys().hasOnly([
          'id', 'pollId', 'slotId', 'playerId',
          'scoreUnitsTotal', 'ratingCount', 'lastResponseId', 'updatedAt'
        ])
        && request.resource.data.id == summaryId
        && summaryId == request.resource.data.pollId + '__'
          + request.resource.data.slotId + '__' + request.resource.data.playerId
        && request.resource.data.pollId is string
        && request.resource.data.slotId is string
        && request.resource.data.playerId is string
        && request.resource.data.scoreUnitsTotal is int
        && request.resource.data.scoreUnitsTotal >= 8
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingCount >= 1
        && request.resource.data.lastResponseId is string
        && request.resource.data.updatedAt is int
        && existsAfter(
          /databases/$(database)/documents/matchFeedbackResponses/$(request.resource.data.lastResponseId)
        )
        && response.data.status == 'submitted'
        && response.data.pollId == request.resource.data.pollId
        && response.data.slotId == request.resource.data.slotId
        && response.data.reviewerId == request.auth.uid
        && response.data.closedAt == request.resource.data.updatedAt;
    }

    function validMatchFeedbackSummaryCreate(summaryId) {
      let response = getAfter(
        /databases/$(database)/documents/matchFeedbackResponses/$(request.resource.data.lastResponseId)
      );
      return validMatchFeedbackSummary(summaryId)
        && request.resource.data.ratingCount == 1
        && feedbackResponseHasRating(
          response,
          request.resource.data.playerId,
          request.resource.data.scoreUnitsTotal
        );
    }

    function validMatchFeedbackSummaryUpdate(summaryId) {
      let response = getAfter(
        /databases/$(database)/documents/matchFeedbackResponses/$(request.resource.data.lastResponseId)
      );
      return validMatchFeedbackSummary(summaryId)
        && request.resource.data.pollId == resource.data.pollId
        && request.resource.data.slotId == resource.data.slotId
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.lastResponseId != resource.data.lastResponseId
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.ratingCount == resource.data.ratingCount + 1
        && request.resource.data.scoreUnitsTotal > resource.data.scoreUnitsTotal
        && feedbackResponseHasRating(
          response,
          request.resource.data.playerId,
          request.resource.data.scoreUnitsTotal - resource.data.scoreUnitsTotal
        );
    }

    function validMatchReportSet(set, participantIds) {
      let playerIds = [
        set.teamA[0].userId,
        set.teamA[1].userId,
        set.teamB[0].userId,
        set.teamB[1].userId
      ];
      let playerIdSet = playerIds.toSet();
      return set.keys().hasOnly(['id', 'teamA', 'teamB', 'scoreA', 'scoreB'])
        && set.teamA.size() == 2
        && set.teamB.size() == 2
        && playerIdSet.size() == 4
        && playerIdSet.hasOnly(participantIds)
        && set.scoreA is int
        && set.scoreB is int
        && set.scoreA >= 0
        && set.scoreB >= 0
        && set.scoreA <= 99
        && set.scoreB <= 99
        && set.scoreA != set.scoreB;
    }

    function validMatchReportSets(sets, participantIds) {
      return sets is list
        && sets.size() >= 1
        && sets.size() <= 5
        && validMatchReportSet(sets[0], participantIds)
        && (sets.size() < 2 || validMatchReportSet(sets[1], participantIds))
        && (sets.size() < 3 || validMatchReportSet(sets[2], participantIds))
        && (sets.size() < 4 || validMatchReportSet(sets[3], participantIds))
        && (sets.size() < 5 || validMatchReportSet(sets[4], participantIds));
    }

    function validMatchReport(reportId) {
      return request.resource.data.keys().hasOnly([
          'id', 'pollId', 'pollTitle', 'slotId', 'sessionStartsAt',
          'participantIds', 'participants', 'sets',
          'createdBy', 'createdByName', 'createdAt',
          'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && request.resource.data.id == reportId
        && reportId == request.resource.data.pollId + '__' + request.resource.data.slotId
        && request.resource.data.pollId is string
        && request.resource.data.pollTitle is string
        && request.resource.data.slotId is string
        && request.resource.data.sessionStartsAt is string
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 4
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 4
        && request.resource.data.participants[0].userId == request.resource.data.participantIds[0]
        && request.resource.data.participants[1].userId == request.resource.data.participantIds[1]
        && request.resource.data.participants[2].userId == request.resource.data.participantIds[2]
        && request.resource.data.participants[3].userId == request.resource.data.participantIds[3]
        && request.resource.data.participantIds.toSet().size() == 4
        && validMatchReportSets(
          request.resource.data.sets,
          request.resource.data.participantIds
        )
        && request.resource.data.createdBy is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdAt is int
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= request.resource.data.createdAt;
    }

    function validFantasyRound(roundId) {
      return request.resource.data.keys().hasOnly([
          'id', 'pollId', 'pollTitle', 'slotId', 'slotStartsAt',
          'slotEndsAt', 'locksAt', 'settlesAt',
          'participantIds', 'participants', 'rosterKey', 'status',
          'createdAt', 'updatedAt', 'settledAt', 'voidReason',
          'playerScores', 'standings'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'pollId', 'pollTitle', 'slotId', 'slotStartsAt',
          'slotEndsAt', 'locksAt', 'settlesAt',
          'participantIds', 'participants', 'rosterKey', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == roundId
        && roundId == request.resource.data.pollId + '__' + request.resource.data.slotId
        && request.resource.data.pollId is string
        && request.resource.data.pollTitle is string
        && request.resource.data.slotId is string
        && request.resource.data.slotStartsAt is string
        && request.resource.data.slotEndsAt is int
        && request.resource.data.locksAt is int
        && request.resource.data.settlesAt is int
        && request.resource.data.locksAt < request.resource.data.slotEndsAt
        && request.resource.data.slotEndsAt < request.resource.data.settlesAt
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 4
        && request.resource.data.participantIds.toSet().size() == 4
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 4
        && request.resource.data.rosterKey is string
        && request.resource.data.status in ['pending', 'open', 'scored', 'void']
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= request.resource.data.createdAt;
    }

    function validMemberFantasyRosterSync(roundId) {
      let pollPath = /databases/$(database)/documents/polls/$(resource.data.pollId);
      let pollBefore = get(pollPath);
      let pollAfter = getAfter(pollPath);
      return isMember()
        && resource.data.status in ['open', 'pending']
        && request.resource.data.status in ['open', 'pending']
        && request.time.toMillis() < resource.data.locksAt
        && pollAfter.data.diff(pollBefore.data).affectedKeys().hasAny(['slots'])
        && pollAfter.data.updatedAt != pollBefore.data.updatedAt
        && request.resource.data.updatedAt == pollAfter.data.updatedAt
        && request.resource.data.updatedAt > resource.data.updatedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantIds', 'participants', 'rosterKey', 'status', 'updatedAt'
        ])
        && validFantasyRound(roundId);
    }

    function validFantasyEntry(roundId, managerId) {
      let round = get(/databases/$(database)/documents/fantasyRounds/$(roundId));
      return request.resource.data.keys().hasOnly([
          'id', 'roundId', 'pollId', 'slotId',
          'managerId', 'managerName', 'playerIds', 'captainId',
          'rosterKey', 'locksAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == managerId
        && request.resource.data.roundId == roundId
        && request.resource.data.pollId == round.data.pollId
        && request.resource.data.slotId == round.data.slotId
        && request.resource.data.managerId == request.auth.uid
        && managerId == request.auth.uid
        && request.resource.data.managerName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.playerIds is list
        && request.resource.data.playerIds.size() == 2
        && request.resource.data.playerIds.toSet().size() == 2
        && round.data.participantIds.hasAll(request.resource.data.playerIds)
        && !round.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.captainId in request.resource.data.playerIds
        && request.resource.data.rosterKey == round.data.rosterKey
        && request.resource.data.locksAt == round.data.locksAt
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= request.resource.data.createdAt
        && round.data.status == 'open'
        && request.time.toMillis() < round.data.locksAt;
    }

    function validActivityEvent() {
      return request.resource.data.keys().hasOnly([
          'type', 'actorId', 'actorName', 'pollId', 'pollTitle',
          'slotId', 'slotStartsAt', 'details', 'occurredAt'
        ])
        && request.resource.data.type in [
          'poll_created', 'poll_archived', 'poll_reopened', 'poll_deleted',
          'slot_created', 'slot_rescheduled', 'slot_deleted',
          'signup_joined', 'signup_left', 'starter_substituted',
          'slot_roster_admin_updated',
          'guest_added', 'guest_removed',
          'slot_booked', 'slot_unbooked'
        ]
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() >= 2
        && request.resource.data.actorName.size() <= 40
        && request.resource.data.pollId is string
        && request.resource.data.pollTitle is string
        && (!request.resource.data.keys().hasAny(['slotId'])
          || request.resource.data.slotId is string)
        && (!request.resource.data.keys().hasAny(['slotStartsAt'])
          || request.resource.data.slotStartsAt is string)
        && request.resource.data.details is map
        && (request.resource.data.type != 'slot_roster_admin_updated' || isSlotAdmin())
        && request.resource.data.occurredAt == request.time;
    }

    function validNotificationDelivery() {
      return request.resource.data.keys().hasOnly([
          'eventId', 'kind', 'title', 'body', 'userId', 'subscriptionId', 'sentAt'
        ])
        && request.resource.data.eventId is string
        && request.resource.data.kind in [
          'new-slots', 'slot-ready', 'starter-substitution', 'booking-reminder-7d',
          'reminder-24h', 'reminder-2h', 'match-rating', 'match-mvp', 'match-feedback',
          'monday-motivation', 'fantasy-open', 'fantasy-roster-changed',
          'fantasy-result', 'test'
        ]
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.userId is string
        && request.resource.data.subscriptionId is string
        && request.resource.data.sentAt == request.time;
    }

    function validMondayMotivationContent() {
      return request.resource.data.keys().hasOnly([
          'messages', 'catalogVersion', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.messages is list
        && request.resource.data.messages.size() >= 100
        && request.resource.data.messages.size() <= 300
        && request.resource.data.catalogVersion is int
        && request.resource.data.catalogVersion >= 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function validSlotView() {
      return request.resource.data.keys().hasOnly([
          'pollId', 'pollTitle', 'slotId', 'slotStartsAt',
          'viewerId', 'viewerName', 'firstViewedAt', 'lastViewedAt', 'viewCount'
        ])
        && request.resource.data.pollId is string
        && request.resource.data.pollTitle is string
        && request.resource.data.slotId is string
        && request.resource.data.slotStartsAt is string
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.viewerName is string
        && request.resource.data.viewerName.size() >= 2
        && request.resource.data.viewerName.size() <= 40
        && request.resource.data.firstViewedAt is timestamp
        && request.resource.data.lastViewedAt is timestamp
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount >= 1;
    }

    match /users/{userId} {
      allow read: if isMember() || isNotifier();
      allow create: if isMember()
        && request.auth.uid == userId
        && validUserProfile(userId);
      allow update: if isMember()
        && request.auth.uid == userId
        && validUserProfile(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.displayName == resource.data.displayName
          || !request.resource.data.displayName.matches('.*[Ee][Vv][Ii].*'));
      allow delete: if false;
    }

    match /polls/{pollId} {
      allow read: if isMember() || isNotifier();
      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.slots is list
        && request.resource.data.slots.size() > 0
        && request.resource.data.slots.size() <= 14;
      allow update: if isMember()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['slots', 'status', 'updatedAt']);
      allow delete: if isMember() && resource.data.createdBy == request.auth.uid;
    }

    match /pushSubscriptions/{subscriptionId} {
      allow get: if isNotifier() || (isMember() && resource.data.userId == request.auth.uid);
      allow list: if isNotifier();
      allow create: if isMember()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.endpoint is string
        && request.resource.data.keys is map;
      allow update: if isMember()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.endpoint == resource.data.endpoint
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['userId', 'keys', 'expirationTime', 'createdAt', 'updatedAt']);
      allow delete: if isNotifier() || (isMember() && resource.data.userId == request.auth.uid);
    }

    match /notificationDeliveries/{deliveryId} {
      allow read: if isNotifier()
        || (isMember() && resource.data.userId == request.auth.uid);
      allow create: if isNotifier() && validNotificationDelivery();
      allow update: if isMember()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if false;
    }

    match /notificationContent/{contentId} {
      allow get: if isNotifier()
        && contentId in ['mondayMotivation', 'motherNames'];
      allow list: if false;
      allow create: if isNotifier()
        && contentId == 'mondayMotivation'
        && validMondayMotivationContent()
        && request.resource.data.createdAt == request.time;
      allow update: if isNotifier()
        && contentId == 'mondayMotivation'
        && validMondayMotivationContent()
        && request.resource.data.createdAt == resource.data.createdAt
        && ((!resource.data.keys().hasAny(['catalogVersion'])
            && request.resource.data.catalogVersion == 2)
          || (resource.data.keys().hasAny(['catalogVersion'])
            && resource.data.catalogVersion is int
            && request.resource.data.catalogVersion == resource.data.catalogVersion + 1));
      allow delete: if false;
    }

    match /activityEvents/{eventId} {
      allow read: if isMember();
      allow create: if isMember() && validActivityEvent();
      allow update, delete: if false;
    }

    match /slotViews/{viewId} {
      allow read: if isMember();
      allow create: if isMember()
        && validSlotView()
        && request.resource.data.firstViewedAt == request.time
        && request.resource.data.lastViewedAt == request.time
        && request.resource.data.viewCount == 1;
      allow update: if isMember()
        && validSlotView()
        && request.resource.data.pollId == resource.data.pollId
        && request.resource.data.slotId == resource.data.slotId
        && request.resource.data.viewerId == resource.data.viewerId
        && request.resource.data.firstViewedAt == resource.data.firstViewedAt
        && request.resource.data.lastViewedAt == request.time
        && request.resource.data.viewCount == resource.data.viewCount + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pollTitle', 'slotStartsAt', 'viewerName', 'lastViewedAt', 'viewCount'
        ]);
      allow delete: if false;
    }

    match /matchRatingResponses/{responseId} {
      allow read: if isNotifier() || (isMember() && resource.data.reviewerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /matchRatings/{ratingId} {
      allow read: if isMember()
        && (resource.data.reviewerId == request.auth.uid
          || resource.data.revieweeId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /matchRatingSummaries/{summaryId} {
      allow read: if isMember() || isNotifier();
      allow create, update, delete: if false;
    }

    match /matchFeedbackResponses/{responseId} {
      allow read: if isNotifier() || (isMember() && resource.data.reviewerId == request.auth.uid);
      allow create: if matchFeedbackEnabled()
        && isMember()
        && validMatchFeedbackResponse(responseId);
      allow update, delete: if false;
    }

    match /matchMvpResponses/{responseId} {
      allow read: if isNotifier() || (isMember() && resource.data.voterId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /matchMvpSummaries/{summaryId} {
      allow read: if isMember() || isNotifier();
      allow create, update, delete: if false;
    }

    match /matchFeedbackSummaries/{summaryId} {
      allow read: if isMember() || isNotifier();
      allow create: if matchFeedbackEnabled()
        && isMember()
        && validMatchFeedbackSummaryCreate(summaryId);
      allow update: if matchFeedbackEnabled()
        && isMember()
        && validMatchFeedbackSummaryUpdate(summaryId);
      allow delete: if false;
    }

    match /matchReports/{reportId} {
      allow read: if isMember() || isNotifier();
      allow create: if isMember()
        && validMatchReport(reportId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.resource.data.updatedAt;
      allow update: if isMember()
        && validMatchReport(reportId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participants', 'sets', 'updatedBy', 'updatedByName', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /fantasyRounds/{roundId} {
      allow read: if isMember() || isNotifier();
      allow create: if fantasyBandejaWritesEnabled()
        && isNotifier()
        && validFantasyRound(roundId);
      allow update: if fantasyBandejaWritesEnabled()
        && ((isNotifier() && validFantasyRound(roundId))
          || validMemberFantasyRosterSync(roundId));
      allow delete: if false;

      match /entries/{managerId} {
        allow get: if isNotifier()
          || (isMember() && (request.auth.uid == managerId
            || request.time.toMillis()
              >= get(/databases/$(database)/documents/fantasyRounds/$(roundId)).data.locksAt));
        allow list: if isNotifier()
          || (isMember() && request.time.toMillis()
            >= get(/databases/$(database)/documents/fantasyRounds/$(roundId)).data.locksAt);
        allow create: if fantasyBandejaWritesEnabled()
          && isMember()
          && validFantasyEntry(roundId, managerId);
        allow update: if fantasyBandejaWritesEnabled()
          && isMember()
          && validFantasyEntry(roundId, managerId)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }
  }
}
