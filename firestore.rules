rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isNotifier() {
      return signedIn()
        && request.auth.token.email == 'codex@kirivoraup.resend.app'
        && request.auth.token.email_verified == true;
    }

    function isMember() {
      return signedIn() && !isNotifier();
    }

    function isSlotAdmin() {
      return isMember() && request.auth.uid == '4VSiYJso4YSWf35Rg8Cp0Q8hVmu2';
    }

    function validAvatar() {
      return !request.resource.data.keys().hasAny(['avatarDataUrl'])
        || (request.resource.data.avatarDataUrl is string
          && request.resource.data.avatarDataUrl.size() <= 100000
          && request.resource.data.avatarDataUrl.matches(
            '^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'
          ));
    }

    function validNotificationPreferences() {
      return !request.resource.data.keys().hasAny(['notificationPreferences'])
        || (request.resource.data.notificationPreferences is map
          && request.resource.data.notificationPreferences.keys().hasOnly([
            'mondayMotivation', 'newSlots', 'slotReady', 'starterSubstitution', 'bookingReminder7d',
            'reminder24h', 'reminder2h', 'matchFeedback', 'matchMvp', 'matchRating', 'fantasy'
          ])
          && request.resource.data.notificationPreferences.keys().hasAll([
            'mondayMotivation', 'newSlots', 'slotReady', 'bookingReminder7d',
            'reminder24h', 'reminder2h'
          ])
          && request.resource.data.notificationPreferences.keys().hasAny(['matchFeedback', 'matchMvp', 'matchRating'])
          && request.resource.data.notificationPreferences.mondayMotivation is bool
          && request.resource.data.notificationPreferences.newSlots is bool
          && request.resource.data.notificationPreferences.slotReady is bool
          && (!request.resource.data.notificationPreferences.keys().hasAny(['starterSubstitution'])
            || request.resource.data.notificationPreferences.starterSubstitution is bool)
          && request.resource.data.notificationPreferences.bookingReminder7d is bool
          && request.resource.data.notificationPreferences.reminder24h is bool
          && request.resource.data.notificationPreferences.reminder2h is bool
          && (!request.resource.data.notificationPreferences.keys().hasAny(['matchFeedback'])
            || request.resource.data.notificationPreferences.matchFeedback is bool)
          && (!request.resource.data.notificationPreferences.keys().hasAny(['matchMvp'])
            || request.resource.data.notificationPreferences.matchMvp is bool)
          && (!request.resource.data.notificationPreferences.keys().hasAny(['matchRating'])
            || request.resource.data.notificationPreferences.matchRating is bool)
          && (!request.resource.data.notificationPreferences.keys().hasAny(['fantasy'])
            || request.resource.data.notificationPreferences.fantasy is bool));
    }

    function validUserProfile(userId) {
      return request.resource.data.keys()
          .hasOnly([
            'id', 'displayName', 'email', 'createdAt', 'avatarDataUrl',
            'notificationPreferences', 'fixedSeatPreference', 'interfaceMode', 'preferredVenueIds'
          ])
        && request.resource.data.id == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.createdAt is number
        && validAvatar()
        && validNotificationPreferences()
        && (!request.resource.data.keys().hasAny(['preferredVenueIds'])
          || (request.resource.data.preferredVenueIds is list
            && request.resource.data.preferredVenueIds.size() <= 3
            && request.resource.data.preferredVenueIds.toSet().size() == request.resource.data.preferredVenueIds.size()
            && request.resource.data.preferredVenueIds.hasOnly(['oasi-boschetto', 'tennis-club-mantova', 'sport-city-mantova'])))
        && (!request.resource.data.keys().hasAny(['interfaceMode'])
          || request.resource.data.interfaceMode in ['classica', 'nuova'])
        && (!request.resource.data.keys().hasAny(['fixedSeatPreference'])
          || (request.resource.data.fixedSeatPreference is map
            && request.resource.data.fixedSeatPreference.keys()
              .hasOnly(['weekday', 'startMinutes', 'endMinutes'])
            && request.resource.data.fixedSeatPreference.keys()
              .hasAll(['weekday', 'startMinutes', 'endMinutes'])
            && request.resource.data.fixedSeatPreference.weekday is int
            && request.resource.data.fixedSeatPreference.weekday >= 1
            && request.resource.data.fixedSeatPreference.weekday <= 7
            && request.resource.data.fixedSeatPreference.startMinutes is int
            && request.resource.data.fixedSeatPreference.startMinutes >= 0
            && request.resource.data.fixedSeatPreference.startMinutes % 30 == 0
            && request.resource.data.fixedSeatPreference.endMinutes is int
            && request.resource.data.fixedSeatPreference.endMinutes <= 1440
            && request.resource.data.fixedSeatPreference.endMinutes % 30 == 0
            && request.resource.data.fixedSeatPreference.endMinutes
              - request.resource.data.fixedSeatPreference.startMinutes >= 60));
    }

    function validMatchFeedbackRating(rating) {
      return rating is map
        && rating.keys().hasOnly(['playerId', 'playerName', 'level', 'scoreUnits'])
        && rating.playerId is string
        && rating.playerId != request.auth.uid
        && rating.playerName is string
        && rating.playerName.size() >= 2
        && rating.playerName.size() <= 40
        && rating.level is int
        && rating.level >= 1
        && rating.level <= 5
        && rating.scoreUnits is int
        && ((rating.level == 1 && rating.scoreUnits == 8)
          || (rating.level == 2 && rating.scoreUnits == 10)
          || (rating.level == 3 && rating.scoreUnits == 12)
          || (rating.level == 4 && rating.scoreUnits == 15)
          || (rating.level == 5 && rating.scoreUnits == 18));
    }

    function validMatchFeedbackRatings(ratings) {
      return ratings is list
        && ratings.size() >= 1
        && ratings.size() <= 3
        && validMatchFeedbackRating(ratings[0])
        && (ratings.size() < 2 || validMatchFeedbackRating(ratings[1]))
        && (ratings.size() < 3 || validMatchFeedbackRating(ratings[2]))
        && (ratings.size() < 2 || ratings[0].playerId != ratings[1].playerId)
        && (ratings.size() < 3 || (ratings[0].playerId != ratings[2].playerId
          && ratings[1].playerId != ratings[2].playerId));
    }

    function feedbackResponseHasRating(response, playerId, scoreUnits) {
      return response.data.ratings.size() >= 1
          && response.data.ratings[0].playerId == playerId
          && response.data.ratings[0].scoreUnits == scoreUnits
        || response.data.ratings.size() >= 2
          && response.data.ratings[1].playerId == playerId
          && response.data.ratings[1].scoreUnits == scoreUnits
        || response.data.ratings.size() >= 3
          && response.data.ratings[2].playerId == playerId
          && response.data.ratings[2].scoreUnits == scoreUnits;
    }

    function validMatchFeedbackResponse(responseId) {
      let isSubmitted = request.resource.data.status == 'submitted';
      return request.resource.data.keys().hasOnly([
          'id', 'pollId', 'slotId', 'reviewerId', 'status', 'ratings', 'closedAt'
        ])
        && request.resource.data.id == responseId
        && responseId == request.resource.data.pollId + '__' + request.resource.data.slotId + '__' + request.auth.uid
        && request.resource.data.pollId is string
        && request.resource.data.slotId is string
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.status in ['dismissed', 'submitted']
        && request.resource.data.closedAt is number
        && (isSubmitted
          ? (request.resource.data.keys().hasAll(['ratings'])
            && validMatchFeedbackRatings(request.resource.data.ratings))
          : !request.resource.data.keys().hasAny(['ratings']));
    }

    function validMatchFeedbackSummary(summaryId) {
      let response = getAfter(
        /databases/$(database)/documents/matchFeedbackResponses/$(request.resource.data.lastResponseId)
      );
      return request.resource.data.keys().hasOnly([
          'id', 'pollId', 'slotId', 'playerId',
          'scoreUnitsTotal', 'ratingCount', 'lastResponseId', 'updatedAt'
        ])
        && request.resource.data.id == summaryId
        && summaryId == request.resource.data.pollId + '__'
          + request.resource.data.slotId + '__' + request.resource.data.playerId
        && request.resource.data.pollId is string
        && request.resource.data.slotId is string
        && request.resource.data.playerId is string
        && request.resource.data.scoreUnitsTotal is int
        && request.resource.data.scoreUnitsTotal >= 8
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingCount >= 1
        && request.resource.data.lastResponseId is string
        && request.resource.data.updatedAt is int
        && existsAfter(
          /databases/$(database)/documents/matchFeedbackResponses/$(request.resource.data.lastResponseId)
        )
        && response.data.status == 'submitted'
        && response.data.pollId == request.resource.data.pollId
        && response.data.slotId == request.resource.data.slotId
        && response.data.reviewerId == request.auth.uid
        && response.data.closedAt == request.resource.data.updatedAt;
    }

    function validMatchFeedbackSummaryCreate(summaryId) {
      let response = getAfter(
        /databases/$(database)/documents/matchFeedbackResponses/$(request.resource.data.lastResponseId)
      );
      return validMatchFeedbackSummary(summaryId)
        && request.resource.data.ratingCount == 1
        && feedbackResponseHasRating(
          response,
          request.resource.data.playerId,
          request.resource.data.scoreUnitsTotal
        );
    }

    function validMatchFeedbackSummaryUpdate(summaryId) {
      let response = getAfter(
        /databases/$(database)/documents/matchFeedbackResponses/$(request.resource.data.lastResponseId)
      );
      return validMatchFeedbackSummary(summaryId)
        && request.resource.data.pollId == resource.data.pollId
        && request.resource.data.slotId == resource.data.slotId
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.lastResponseId != resource.data.lastResponseId
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.ratingCount == resource.data.ratingCount + 1
        && request.resource.data.scoreUnitsTotal > resource.data.scoreUnitsTotal
        && feedbackResponseHasRating(
          response,
          request.resource.data.playerId,
          request.resource.data.scoreUnitsTotal - resource.data.scoreUnitsTotal
        );
    }

    function validMatchReportSet(set, participantIds) {
      let playerIds = [
        set.teamA[0].userId,
        set.teamA[1].userId,
        set.teamB[0].userId,
        set.teamB[1].userId
      ];
      let playerIdSet = playerIds.toSet();
      return set.keys().hasOnly(['id', 'teamA', 'teamB', 'scoreA', 'scoreB'])
        && set.teamA.size() == 2
        && set.teamB.size() == 2
        && playerIdSet.size() == 4
        && playerIdSet.hasOnly(participantIds)
        && set.scoreA is int
        && set.scoreB is int
        && set.scoreA >= 0
        && set.scoreB >= 0
        && set.scoreA <= 99
        && set.scoreB <= 99
        && set.scoreA != set.scoreB;
    }

    function validMatchReportSets(sets, participantIds) {
      return sets is list
        && sets.size() >= 1
        && sets.size() <= 5
        && validMatchReportSet(sets[0], participantIds)
        && (sets.size() < 2 || validMatchReportSet(sets[1], participantIds))
        && (sets.size() < 3 || validMatchReportSet(sets[2], participantIds))
        && (sets.size() < 4 || validMatchReportSet(sets[3], participantIds))
        && (sets.size() < 5 || validMatchReportSet(sets[4], participantIds));
    }

    function validMatchReport(reportId) {
      return request.resource.data.keys().hasOnly([
          'id', 'pollId', 'pollTitle', 'slotId', 'sessionStartsAt',
          'participantIds', 'participants', 'sets',
          'createdBy', 'createdByName', 'createdAt',
          'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && request.resource.data.id == reportId
        && reportId == request.resource.data.pollId + '__' + request.resource.data.slotId
        && request.resource.data.pollId is string
        && request.resource.data.pollTitle is string
        && request.resource.data.slotId is string
        && request.resource.data.sessionStartsAt is string
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 4
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 4
        && request.resource.data.participants[0].userId == request.resource.data.participantIds[0]
        && request.resource.data.participants[1].userId == request.resource.data.participantIds[1]
        && request.resource.data.participants[2].userId == request.resource.data.participantIds[2]
        && request.resource.data.participants[3].userId == request.resource.data.participantIds[3]
        && request.resource.data.participantIds.toSet().size() == 4
        && validMatchReportSets(
          request.resource.data.sets,
          request.resource.data.participantIds
        )
        && request.resource.data.createdBy is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdAt is int
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= request.resource.data.createdAt;
    }

    function validFantasyRound(roundId) {
      return request.resource.data.keys().hasOnly([
          'id', 'pollId', 'pollTitle', 'slotId', 'slotStartsAt',
          'slotEndsAt', 'locksAt', 'settlesAt',
          'participantIds', 'participants', 'rosterKey', 'status',
          'createdAt', 'updatedAt', 'settledAt', 'voidReason',
          'hasMatchReport', 'feedbackResponseCount', 'settlementReadyAt',
          'playerScores', 'standings'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'pollId', 'pollTitle', 'slotId', 'slotStartsAt',
          'slotEndsAt', 'locksAt', 'settlesAt',
          'participantIds', 'participants', 'rosterKey', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == roundId
        && roundId == request.resource.data.pollId + '__' + request.resource.data.slotId
        && request.resource.data.pollId is string
        && request.resource.data.pollTitle is string
        && request.resource.data.slotId is string
        && request.resource.data.slotStartsAt is string
        && request.resource.data.slotEndsAt is int
        && request.resource.data.locksAt is int
        && request.resource.data.settlesAt is int
        && request.resource.data.locksAt < request.resource.data.slotEndsAt
        && request.resource.data.slotEndsAt < request.resource.data.settlesAt
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 4
        && request.resource.data.participantIds.toSet().size() == 4
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 4
        && request.resource.data.rosterKey is string
        && request.resource.data.status in ['pending', 'open', 'scored', 'void']
        && (!request.resource.data.keys().hasAny(['hasMatchReport'])
          || request.resource.data.hasMatchReport is bool)
        && (!request.resource.data.keys().hasAny(['feedbackResponseCount'])
          || (request.resource.data.feedbackResponseCount is int
            && request.resource.data.feedbackResponseCount >= 0
            && request.resource.data.feedbackResponseCount <= 4))
        && (!request.resource.data.keys().hasAny(['settlementReadyAt'])
          || (request.resource.data.settlementReadyAt is int
            && request.resource.data.settlementReadyAt >= request.resource.data.slotEndsAt))
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= request.resource.data.createdAt;
    }

    function validMemberFantasyRosterSync(roundId) {
      let pollPath = /databases/$(database)/documents/polls/$(resource.data.pollId);
      let pollBefore = get(pollPath);
      let pollAfter = getAfter(pollPath);
      return isMember()
        && resource.data.status in ['open', 'pending']
        && request.resource.data.status in ['open', 'pending']
        && request.time.toMillis() < resource.data.locksAt
        && pollAfter.data.diff(pollBefore.data).affectedKeys().hasAny(['slots'])
        && pollAfter.data.updatedAt != pollBefore.data.updatedAt
        && request.resource.data.updatedAt == pollAfter.data.updatedAt
        && request.resource.data.updatedAt > resource.data.updatedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantIds', 'participants', 'rosterKey', 'status', 'updatedAt'
        ])
        && validFantasyRound(roundId);
    }

    function validFantasyEntry(roundId, managerId) {
      let round = get(/databases/$(database)/documents/fantasyRounds/$(roundId));
      return request.resource.data.keys().hasOnly([
          'id', 'roundId', 'pollId', 'slotId',
          'managerId', 'managerName', 'playerIds', 'captainId',
          'rosterKey', 'locksAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == managerId
        && request.resource.data.roundId == roundId
        && request.resource.data.pollId == round.data.pollId
        && request.resource.data.slotId == round.data.slotId
        && request.resource.data.managerId == request.auth.uid
        && managerId == request.auth.uid
        && request.resource.data.managerName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.playerIds is list
        && request.resource.data.playerIds.size() == 2
        && request.resource.data.playerIds.toSet().size() == 2
        && round.data.participantIds.hasAll(request.resource.data.playerIds)
        && !round.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.captainId in request.resource.data.playerIds
        && request.resource.data.rosterKey == round.data.rosterKey
        && request.resource.data.locksAt == round.data.locksAt
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= request.resource.data.createdAt
        && round.data.status == 'open'
        && request.time.toMillis() < round.data.locksAt;
    }

    function validActivityEvent() {
      return request.resource.data.keys().hasOnly([
          'type', 'actorId', 'actorName', 'pollId', 'pollTitle',
          'slotId', 'slotStartsAt', 'details', 'occurredAt'
        ])
        && request.resource.data.type in [
          'poll_created', 'poll_archived', 'poll_reopened', 'poll_deleted',
          'slot_created', 'slot_rescheduled', 'slot_deleted',
          'signup_joined', 'fixed_seat_auto_joined', 'signup_left', 'starter_substituted',
          'slot_roster_admin_updated',
          'guest_added', 'guest_removed',
          'slot_booked', 'slot_unbooked'
        ]
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() >= 2
        && request.resource.data.actorName.size() <= 40
        && request.resource.data.pollId is string
        && request.resource.data.pollTitle is string
        && (!request.resource.data.keys().hasAny(['slotId'])
          || request.resource.data.slotId is string)
        && (!request.resource.data.keys().hasAny(['slotStartsAt'])
          || request.resource.data.slotStartsAt is string)
        && request.resource.data.details is map
        && (request.resource.data.type != 'slot_roster_admin_updated' || isSlotAdmin())
        && request.resource.data.occurredAt == request.time;
    }

    function validNotificationDelivery() {
      return request.resource.data.keys().hasOnly([
          'eventId', 'kind', 'title', 'body', 'userId', 'subscriptionId', 'sentAt'
        ])
        && request.resource.data.eventId is string
        && request.resource.data.kind in [
          'new-slots', 'slot-ready', 'starter-substitution', 'booking-reminder-7d',
          'fixed-seat-auto-join',
          'reminder-24h', 'reminder-2h', 'match-rating', 'match-mvp', 'match-feedback',
          'monday-motivation', 'fantasy-open', 'fantasy-roster-changed',
          'fantasy-result', 'test'
        ]
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.userId is string
        && request.resource.data.subscriptionId is string
        && request.resource.data.sentAt == request.time;
    }

    function validMondayMotivationContent() {
      return request.resource.data.keys().hasOnly([
          'messages', 'catalogVersion', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.messages is list
        && request.resource.data.messages.size() >= 100
        && request.resource.data.messages.size() <= 300
        && request.resource.data.catalogVersion is int
        && request.resource.data.catalogVersion >= 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function validSlotView() {
      return request.resource.data.keys().hasOnly([
          'pollId', 'pollTitle', 'slotId', 'slotStartsAt',
          'viewerId', 'viewerName', 'firstViewedAt', 'lastViewedAt', 'viewCount'
        ])
        && request.resource.data.pollId is string
        && request.resource.data.pollTitle is string
        && request.resource.data.slotId is string
        && request.resource.data.slotStartsAt is string
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.viewerName is string
        && request.resource.data.viewerName.size() >= 2
        && request.resource.data.viewerName.size() <= 40
        && request.resource.data.firstViewedAt is timestamp
        && request.resource.data.lastViewedAt is timestamp
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount >= 1;
    }

    match /users/{userId} {
      allow read: if isMember() || isNotifier();
      allow create: if isMember()
        && request.auth.uid == userId
        && validUserProfile(userId);
      allow update: if isMember()
        && request.auth.uid == userId
        && validUserProfile(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.displayName == resource.data.displayName
          || !request.resource.data.displayName.matches('.*[Ee][Vv][Ii].*'));
      allow delete: if false;
    }

    match /fixedSeatBuckets/{bucketId} {
      allow read: if isMember() || isNotifier();
      allow create: if isMember()
        && bucketId.matches('^[1-7]-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['members'])
        && request.resource.data.members is map
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true;
      allow update: if isMember()
        && bucketId.matches('^[1-7]-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['members'])
        && request.resource.data.members is map
        && request.resource.data.members.keys().size() >= 1
        && request.resource.data.members.keys().size() <= 3
        && request.resource.data.members.diff(resource.data.members).affectedKeys()
          .hasOnly([request.auth.uid])
        && (!request.resource.data.members.keys().hasAny([request.auth.uid])
          || request.resource.data.members[request.auth.uid] == true);
      allow delete: if isMember()
        && resource.data.members is map
        && resource.data.members.keys().hasOnly([request.auth.uid])
        && resource.data.members[request.auth.uid] == true;
    }

    // Same budget arithmetic as the pure planner; the draw freezes actual attendance.
    function validAdaptiveTournamentPlan(data) {
      let players = data.currentRound > 0 ? data.registrations.size() : data.capacity;
      let teams = int(players / 2);
      let matches = int(teams * (teams - 1) / 2);
      let baseRounds = teams % 2 == 1 ? teams : teams - 1;
      let courtRounds = int((matches + data.courts - 1) / data.courts);
      let rounds = baseRounds > courtRounds ? baseRounds : courtRounds;
      let minutes = int((data.totalMinutes - data.get('warmupMinutes', 5)
        - (rounds - 1) * data.get('changeoverMinutes', 2)) / rounds);
      return players >= 6 && players % 2 == 0 && minutes >= 5
        && data.get('matchMinutes', 15) == minutes
        && (data.currentRound == 0 || (data.totalRounds == rounds && data.currentRound <= rounds));
    }

    function validTournament(data) {
      return data.keys().hasOnly(['id', 'title', 'startsAt', 'venueId', 'format', 'pairing', 'capacity',
          'courts', 'rounds', 'pointsPerMatch', 'scoreAccess', 'published', 'status', 'createdBy',
          'createdAt', 'updatedAt', 'registrations', 'teams', 'matches', 'currentRound', 'totalRounds', 'seed',
          'scoringMode', 'matchMinutes', 'warmupMinutes', 'changeoverMinutes', 'roundStartedAt', 'totalMinutes'])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 80
        && data.startsAt is number
        && data.venueId in ['oasi-boschetto', 'tennis-club-mantova', 'sport-city-mantova']
        && data.format in ['americano', 'mexicano', 'round-robin', 'knockout']
        && data.pairing in ['rotating', 'random-fixed', 'chosen-fixed']
        && data.capacity is int && data.capacity >= 4 && data.capacity <= 32
        && data.courts is int && data.courts >= 1 && data.courts <= 8
        && data.rounds is int && data.rounds >= 1 && data.rounds <= 31
        && data.pointsPerMatch in [16, 24, 32]
        && data.scoreAccess in ['players', 'admin']
        && data.published is bool
        && data.status in ['draft', 'open', 'running', 'completed', 'cancelled']
        && data.createdBy is string && data.createdBy.size() > 0
        && data.createdAt is number && data.updatedAt is number
        && data.registrations is map && data.registrations.size() <= data.capacity
        && data.teams is list && data.teams.size() <= 16
        && data.matches is map && data.matches.size() <= 256
        && data.currentRound is int && data.currentRound >= 0 && data.currentRound <= (data.get('totalMinutes', null) == null ? 31 : 120)
        && data.totalRounds is int && data.totalRounds >= 0 && data.totalRounds <= (data.get('totalMinutes', null) == null ? 31 : 120)
        && data.seed is int && data.seed >= 0 && data.seed <= 4294967295
        && data.get('scoringMode', 'standard') in ['standard', 'timed']
        && (data.get('scoringMode', 'standard') != 'timed'
          || (data.format == 'round-robin' && (data.get('totalMinutes', null) != null || data.courts >= int(data.capacity / 4))))
        && (data.get('totalMinutes', null) == null || (data.totalMinutes is int && data.totalMinutes >= 15 && data.totalMinutes <= 720
          && data.get('scoringMode', 'standard') == 'timed' && data.capacity >= 6 && data.capacity % 2 == 0))
        && data.get('matchMinutes', 15) is int && data.get('matchMinutes', 15) >= 5 && data.get('matchMinutes', 15) <= (data.get('totalMinutes', null) == null ? 30 : 240)
        && data.get('warmupMinutes', 5) is int && data.get('warmupMinutes', 5) >= 0 && data.get('warmupMinutes', 5) <= 15
        && data.get('changeoverMinutes', 2) is int && data.get('changeoverMinutes', 2) >= 0 && data.get('changeoverMinutes', 2) <= 5
        && (data.get('roundStartedAt', null) == null || data.roundStartedAt is number)
        && (data.get('totalMinutes', null) == null || validAdaptiveTournamentPlan(data));
    }

    function validTournamentSettingsUpdate(before, after) {
      let changed = after.diff(before).affectedKeys();
      let settings = ['title', 'startsAt', 'venueId', 'format', 'pairing', 'capacity', 'courts',
        'rounds', 'pointsPerMatch', 'scoreAccess', 'scoringMode', 'matchMinutes',
        'warmupMinutes', 'changeoverMinutes', 'totalMinutes'];
      // Keep all registrations and the saved draw intact when editing settings.
      return before.status == 'draft'
        || !changed.hasAny(settings)
        || (isSlotAdmin() && changed.hasOnly(['title', 'venueId', 'updatedAt']))
        || (before.status == 'open' && after.status == 'open'
          && (isSlotAdmin() || request.time.toMillis() < before.startsAt - 3600000)
          && changed.hasOnly(settings.concat(['updatedAt']))
          && (after.startsAt == before.startsAt || after.startsAt > request.time.toMillis() + 3600000)
          && (before.registrations.size() == 0 || (after.format == before.format
            && after.pairing == before.pairing && after.pointsPerMatch == before.pointsPerMatch)))
        || (before.status == 'open' && after.status == 'running' && before.get('totalMinutes', null) != null
          && request.time.toMillis() >= before.startsAt - 3600000
          && !changed.hasAny(['title', 'startsAt', 'venueId', 'format', 'pairing', 'capacity', 'courts',
            'rounds', 'pointsPerMatch', 'scoreAccess', 'scoringMode', 'warmupMinutes', 'changeoverMinutes', 'totalMinutes']));
    }

    // Legacy tournaments retain their clock. A new budget is opt-in before cutoff.
    function validTournamentTimingUpdate(before, after) {
      let start = before.get('roundStartedAt', null);
      let nextStart = after.get('roundStartedAt', null);
      let expired = start != null && request.time.toMillis() >= start + before.get('matchMinutes', 15) * 60000;
      // Metadata corrections must also work on completed timed tournaments.
      return !after.diff(before).affectedKeys().hasAny(['status', 'currentRound', 'roundStartedAt'])
        || ((before.status != 'open' || after.status != 'running' || request.time.toMillis() >= before.startsAt - 3600000)
        && (after.get('scoringMode', 'standard') != 'timed' || (
          before.status != 'running' ? nextStart == null : (
            after.status == 'cancelled' ? nextStart == start : (
              after.status == 'completed' ? expired && nextStart == start
                && before.currentRound == before.totalRounds && after.currentRound == before.currentRound : (
                after.currentRound == before.currentRound + 1
                  ? expired && nextStart == null && after.status == 'running'
                  : after.currentRound == before.currentRound && after.status == 'running'
                    && (nextStart == start || (start == null && nextStart != null
                      && request.time.toMillis() >= before.startsAt
                      && nextStart >= request.time.toMillis() - 120000
                      && nextStart <= request.time.toMillis() + 120000))
              )
            )
          )
        )));
    }

    function validOwnTournamentRegistration(data, before) {
      let uid = request.auth.uid;
      let registration = data.registrations.get(uid, {});
      return !(uid in data.registrations) || (
        registration.keys().hasOnly(['userId', 'displayName', 'joinedAt', 'partnerId'])
        && registration.userId == uid
        && registration.displayName is string && registration.displayName.size() >= 1 && registration.displayName.size() <= 80
        && registration.joinedAt is number
        && (uid in before.registrations
          ? registration.joinedAt == before.registrations[uid].joinedAt
          : registration.joinedAt >= request.time.toMillis() - 120000 && registration.joinedAt <= request.time.toMillis() + 120000)
        && (registration.partnerId == null || (
          data.pairing == 'chosen-fixed' && registration.partnerId is string
          && registration.partnerId != uid && registration.partnerId in data.registrations))
      );
    }

    // A self-signup cannot touch logistics or the draw: validate only the changed
    // map entry, not the unchanged budget again (Firestore's 1000-expression cap).
    function validOwnTournamentUpdate(before, after) {
      return after.diff(before).affectedKeys().hasOnly(['registrations', 'updatedAt'])
        && after.registrations is map && after.registrations.size() <= before.capacity
        && after.registrations.diff(before.registrations).affectedKeys().hasOnly([request.auth.uid])
        && after.updatedAt is number
        && before.published == true && before.status == 'open'
        && request.time.toMillis() < before.startsAt - 3600000
        && validOwnTournamentRegistration(after, before);
    }

    match /tournaments/{tournamentId} {
      // Creation transactions first check that the generated document id is unused.
      allow get: if isMember() && !exists(/databases/$(database)/documents/tournaments/$(tournamentId));
      allow read: if isSlotAdmin() || (isMember()
        && (resource.data.published == true || resource.data.createdBy == request.auth.uid));
      allow create: if isMember() && validTournament(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.id == tournamentId && request.resource.data.status == 'draft'
        && request.resource.data.published == false && request.resource.data.registrations.size() == 0
        && request.resource.data.matches.size() == 0
        && request.resource.data.get('roundStartedAt', null) == null;
      allow update: if isMember() && (validOwnTournamentUpdate(resource.data, request.resource.data) || (
        (isSlotAdmin() || resource.data.createdBy == request.auth.uid)
        && validTournament(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && validTournamentSettingsUpdate(resource.data, request.resource.data)
        && validTournamentTimingUpdate(resource.data, request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['registrations'])
          || (resource.data.published == true && resource.data.status == 'open'
            && request.time.toMillis() < resource.data.startsAt - 3600000))
      ));
      allow delete: if false;

      match /scores/{matchId} {
        function tournament() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        function validScore() {
          let parent = tournament();
          let fixture = parent.matches[matchId];
          let data = request.resource.data;
          let high = data.scoreA > data.scoreB ? data.scoreA : data.scoreB;
          let low = data.scoreA < data.scoreB ? data.scoreA : data.scoreB;
          return parent.published == true && parent.status == 'running'
            && fixture.round == parent.currentRound && request.time.toMillis() >= parent.startsAt
            && (isSlotAdmin() || parent.createdBy == request.auth.uid || (parent.scoreAccess == 'players'
              && (request.auth.uid in fixture.teamA.playerIds || request.auth.uid in fixture.teamB.playerIds)))
            && data.keys().hasOnly(['matchId', 'scoreA', 'scoreB', 'updatedBy', 'updatedAt', 'revision'])
            && data.matchId == matchId && data.updatedBy == request.auth.uid
            && data.updatedAt is number && data.revision is int
            && data.scoreA is int && data.scoreB is int && data.scoreA >= 0 && data.scoreB >= 0
            && (parent.get('scoringMode', 'standard') == 'timed'
              ? parent.get('roundStartedAt', null) != null && request.time.toMillis() >= parent.roundStartedAt
                && data.scoreA <= 99 && data.scoreB <= 99
              : parent.format in ['americano', 'mexicano']
              ? data.scoreA + data.scoreB == parent.pointsPerMatch
              : ((high == 6 && low <= 4) || (high == 7 && low in [5, 6])));
        }
        allow read: if isSlotAdmin() || (isMember()
          && (tournament().published == true || tournament().createdBy == request.auth.uid));
        allow create: if isMember() && validScore() && request.resource.data.revision == 1;
        allow update: if isMember() && validScore() && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }
    }

    match /polls/{pollId} {
      allow read: if isMember() || isNotifier();
      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.slots is list
        && request.resource.data.slots.size() > 0
        && request.resource.data.slots.size() <= 14;
      allow update: if isMember()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['slots', 'status', 'updatedAt']);
      allow delete: if isMember() && resource.data.createdBy == request.auth.uid;
    }

    match /pushSubscriptions/{subscriptionId} {
      allow get: if isNotifier() || (isMember() && resource.data.userId == request.auth.uid);
      allow list: if isNotifier();
      allow create: if isMember()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.endpoint is string
        && request.resource.data.keys is map;
      allow update: if isMember()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.endpoint == resource.data.endpoint
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['userId', 'keys', 'expirationTime', 'createdAt', 'updatedAt']);
      allow delete: if isNotifier() || (isMember() && resource.data.userId == request.auth.uid);
    }

    match /notificationDeliveries/{deliveryId} {
      allow read: if isNotifier()
        || (isMember() && resource.data.userId == request.auth.uid);
      allow create: if isNotifier() && validNotificationDelivery();
      allow update: if isMember()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if false;
    }

    match /notificationContent/{contentId} {
      allow get: if isNotifier()
        && contentId in ['mondayMotivation', 'motherNames'];
      allow list: if false;
      allow create: if isNotifier()
        && contentId == 'mondayMotivation'
        && validMondayMotivationContent()
        && request.resource.data.createdAt == request.time;
      allow update: if isNotifier()
        && contentId == 'mondayMotivation'
        && validMondayMotivationContent()
        && request.resource.data.createdAt == resource.data.createdAt
        && ((!resource.data.keys().hasAny(['catalogVersion'])
            && request.resource.data.catalogVersion == 2)
          || (resource.data.keys().hasAny(['catalogVersion'])
            && resource.data.catalogVersion is int
            && request.resource.data.catalogVersion == resource.data.catalogVersion + 1));
      allow delete: if false;
    }

    match /activityEvents/{eventId} {
      allow read: if isMember();
      allow create: if isMember() && validActivityEvent();
      allow update, delete: if false;
    }

    match /slotViews/{viewId} {
      allow read: if isMember();
      allow create: if isMember()
        && validSlotView()
        && request.resource.data.firstViewedAt == request.time
        && request.resource.data.lastViewedAt == request.time
        && request.resource.data.viewCount == 1;
      allow update: if isMember()
        && validSlotView()
        && request.resource.data.pollId == resource.data.pollId
        && request.resource.data.slotId == resource.data.slotId
        && request.resource.data.viewerId == resource.data.viewerId
        && request.resource.data.firstViewedAt == resource.data.firstViewedAt
        && request.resource.data.lastViewedAt == request.time
        && request.resource.data.viewCount == resource.data.viewCount + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pollTitle', 'slotStartsAt', 'viewerName', 'lastViewedAt', 'viewCount'
        ]);
      allow delete: if false;
    }

    match /matchRatingResponses/{responseId} {
      allow read: if isNotifier() || (isMember() && resource.data.reviewerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /matchRatings/{ratingId} {
      allow read: if isMember()
        && (resource.data.reviewerId == request.auth.uid
          || resource.data.revieweeId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /matchRatingSummaries/{summaryId} {
      allow read: if isMember() || isNotifier();
      allow create, update, delete: if false;
    }

    match /matchFeedbackResponses/{responseId} {
      allow read: if isNotifier() || (isMember() && resource.data.reviewerId == request.auth.uid);
      allow create: if isMember() && validMatchFeedbackResponse(responseId);
      allow update, delete: if false;
    }

    match /matchMvpResponses/{responseId} {
      allow read: if isNotifier() || (isMember() && resource.data.voterId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /matchMvpSummaries/{summaryId} {
      allow read: if isMember() || isNotifier();
      allow create, update, delete: if false;
    }

    match /matchFeedbackSummaries/{summaryId} {
      allow read: if isMember() || isNotifier();
      allow create: if isMember() && validMatchFeedbackSummaryCreate(summaryId);
      allow update: if isMember() && validMatchFeedbackSummaryUpdate(summaryId);
      allow delete: if false;
    }

    match /matchReports/{reportId} {
      allow read: if isMember() || isNotifier();
      allow create: if isMember()
        && validMatchReport(reportId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.resource.data.updatedAt;
      allow update: if isMember()
        && validMatchReport(reportId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participants', 'sets', 'updatedBy', 'updatedByName', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /fantasyRounds/{roundId} {
      allow read: if isMember() || isNotifier();
      allow create: if isNotifier() && validFantasyRound(roundId);
      allow update: if (isNotifier() && validFantasyRound(roundId))
        || validMemberFantasyRosterSync(roundId);
      allow delete: if false;

      match /entries/{managerId} {
        allow get: if isNotifier()
          || (isMember() && (request.auth.uid == managerId
            || request.time.toMillis()
              >= get(/databases/$(database)/documents/fantasyRounds/$(roundId)).data.locksAt));
        allow list: if isNotifier()
          || (isMember() && request.time.toMillis()
            >= get(/databases/$(database)/documents/fantasyRounds/$(roundId)).data.locksAt);
        allow create: if isMember() && validFantasyEntry(roundId, managerId);
        allow update: if isMember()
          && validFantasyEntry(roundId, managerId)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }
  }
}
